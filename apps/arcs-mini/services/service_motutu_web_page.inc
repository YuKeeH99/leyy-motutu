"function normalizePose(src){const stand=defaultStandPose();if(Array.isArray(src)){return {lf:clamp(src[0]??stand.lf,0,270),rf:clamp(src[1]??stand.rf,0,270),lr:clamp(src[2]??stand.lr,0,270),rr:clamp(src[3]??stand.rr,0,270)};}src=src||{};return {lf:clamp(src.lf??src.leftFront??src.LF??stand.lf,0,270),rf:clamp(src.rf??src.rightFront??src.RF??stand.rf,0,270),lr:clamp(src.lr??src.leftRear??src.LR??stand.lr,0,270),rr:clamp(src.rr??src.rightRear??src.RR??stand.rr,0,270)};}\n"
