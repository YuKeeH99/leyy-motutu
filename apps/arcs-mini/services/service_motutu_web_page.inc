"function qs(id){return document.getElementById(id);}function qsa(sel){return Array.from(document.querySelectorAll(sel));}function clamp(v,min,max){v=Number(v);if(Number.isNaN(v))v=min;return Math.max(min,Math.min(max,v));}function sleep(ms){return new Promise(resolve=>setTimeout(resolve,ms));}function deepCopy(v){return JSON.parse(JSON.stringify(v));}function setOut(v){const text=typeof v==='string'?v:JSON.stringify(v,null,2);['out','outTop'].forEach(id=>{const el=qs(id);if(el)el.textContent=text;});}const PRESET_PULSES={init:{lf:1500,rf:1500,lr:1315,rr:1315},stand:{lf:1950,rf:1050,lr:950,rr:1750}};function getJointMeta(key){const arr=state.meta&&state.meta.joints?state.meta.joints:[];const raw=arr.find(j=>j.key===key);if(raw){return Object.assign({},raw,{pulse_center_us:Number(raw.pulse_center_us??raw.center_us??(key==='lf'||key==='rf'?1500:1315)),pulse_min_us:Number(raw.pulse_min_us??raw.min_us??500),pulse_max_us:Number(raw.pulse_max_us??raw.max_us??2500)});}return {key,dir:key==='rf'||key==='rr'?-1:1,center_abs_deg:key==='lf'||key==='rf'?90:110,pulse_center_us:key==='lf'||key==='rf'?1500:1315,pulse_min_us:500,pulse_max_us:2500,min_abs_deg:0,max_abs_deg:270,min_logical_deg:key==='lf'?-180:(key==='rf'?-100:(key==='lr'?-90:-180)),max_logical_deg:key==='lf'?120:(key==='rf'?100:(key==='lr'?180:100))};}function presetPulseForJoint(kind,key){const preset=PRESET_PULSES[kind]||PRESET_PULSES.stand;return Number(preset[key]);}function clampPulseForJoint(key,pulse){const j=getJointMeta(key);return Math.round(clamp(pulse,j.pulse_min_us??500,j.pulse_max_us??2500));}function pulseToLogical(pulse,key){const j=getJointMeta(key);let value=clamp(pulse,j.pulse_min_us??500,j.pulse_max_us??2500);const center=Number(j.pulse_center_us??(key==='lf'||key==='rf'?1500:1315));const minPulse=Number(j.pulse_min_us??500);const maxPulse=Number(j.pulse_max_us??2500);const minLogical=Number(j.min_logical_deg??-180);const maxLogical=Number(j.max_logical_deg??180);const dir=Number(j.dir??1);if(value===center)return 0;if(dir>=0){if(value>center){const span=maxPulse-center;return span>0?((value-center)*maxLogical)/span:0;}const span=center-minPulse;return span>0?-(((center-value)*(-minLogical))/span):0;}if(value<center){const span=center-minPulse;return span>0?(((center-value)*maxLogical)/span):0;}const span=maxPulse-center;return span>0?-(((value-center)*(-minLogical))/span):0;}function logicalToPulse(logical,key){const j=getJointMeta(key);const center=Number(j.pulse_center_us??(key==='lf'||key==='rf'?1500:1315));const minPulse=Number(j.pulse_min_us??500);const maxPulse=Number(j.pulse_max_us??2500);const minLogical=Number(j.min_logical_deg??-180);const maxLogical=Number(j.max_logical_deg??180);const dir=Number(j.dir??1);const value=Number(logical);let pulse=center;if(dir>=0){if(value>=0){const span=maxPulse-center;pulse=center+(maxLogical!==0?(value*span)/maxLogical:0);}else{const span=center-minPulse;pulse=center-((-minLogical)!==0?((-value)*span)/(-minLogical):0);}}else if(value>=0){const span=center-minPulse;pulse=center-(maxLogical!==0?(value*span)/maxLogical:0);}else{const span=maxPulse-center;pulse=center+((-minLogical)!==0?((-value)*span)/(-minLogical):0);}return clampPulseForJoint(key,pulse);}function pulseToAbs(pulse,key){return logicalToAbs(pulseToLogical(pulse,key),key);}function presetLogicalForJoint(kind,key){return pulseToLogical(presetPulseForJoint(kind,key),key);}function presetPulseMap(kind){return JOINT_KEYS.reduce((acc,key)=>{acc[key]=presetPulseForJoint(kind,key);return acc;},{});}function pulseMapToAbs(pulseMap){return JOINT_KEYS.reduce((acc,key)=>{acc[key]=pulseToAbs(Number(pulseMap[key]),key);return acc;},{});}function standLogicalForJoint(key){return presetLogicalForJoint('stand',key);}function standTravelForJoint(key){return Math.max(8,Math.round(Math.abs(standLogicalForJoint(key))));}function towardCalibrateOffset(key,ratio,minDeg){const base=standLogicalForJoint(key);const amount=Math.max(minDeg??4,Math.round(standTravelForJoint(key)*ratio));return base>=0?-amount:amount;}function awayFromCalibrateOffset(key,ratio,minDeg){return -towardCalibrateOffset(key,ratio,minDeg);}function towardCalibratePulse(key,ratio,minUs){const stand=presetPulseForJoint('stand',key);const init=presetPulseForJoint('init',key);const amount=Math.max(minUs??24,Math.round(Math.abs(init-stand)*ratio));return clampPulseForJoint(key,stand+Math.sign(init-stand)*amount);}function awayFromCalibratePulse(key,ratio,minUs){const stand=presetPulseForJoint('stand',key);const init=presetPulseForJoint('init',key);const amount=Math.max(minUs??24,Math.round(Math.abs(init-stand)*ratio));return clampPulseForJoint(key,stand-Math.sign(init-stand)*amount);}function buildPulseFrame(name,pulseMap,v,d){const p={};const s={};JOINT_KEYS.forEach(key=>{const pulse=clampPulseForJoint(key,pulseMap[key]??presetPulseForJoint('stand',key));p[key]=pulse;s[key]=pulseToAbs(pulse,key);});return {name,p:p,s:s,v:clamp(v,20,5000),d:clamp(d||0,0,10000)};}function pulseDeltaMax(a,b){let delta=0;JOINT_KEYS.forEach(key=>{delta=Math.max(delta,Math.abs(Number((a&&a[key])??presetPulseForJoint('stand',key))-Number((b&&b[key])??presetPulseForJoint('stand',key))));});return delta;}function easeInOut(t){const x=clamp(t,0,1);return 0.5-(Math.cos(Math.PI*x)/2);}function smoothGeneratedFrames(kind,frames){if(!Array.isArray(frames)||!frames.length||kind==='stand'||kind==='init'){return frames||[];}let prev=presetPulseMap('stand');const out=[];frames.forEach((frame,idx)=>{const target=(frame&&frame.p)?frame.p:presetPulseMap('stand');const name=frame&&frame.name?frame.name:`frame-${idx+1}`;const move=clamp(frame&&frame.v||300,20,5000);const hold=clamp(frame&&frame.d||0,0,10000);const delta=pulseDeltaMax(prev,target);let parts=1;if(delta>=220)parts=4;else if(delta>=140)parts=3;else if(delta>=70)parts=2;const piece=Math.max(20,Math.floor(move/parts));let used=0;for(let i=1;i<=parts;i++){const isLast=i===parts;const interp=JOINT_KEYS.reduce((acc,key)=>{acc[key]=clampPulseForJoint(key,Math.round(Number(prev[key])+((Number(target[key])-Number(prev[key]))*easeInOut(i/parts))));return acc;},{});const stepMove=isLast?Math.max(20,move-used):piece;used+=stepMove;out.push(buildPulseFrame(isLast?name:`${name}-ease-${i}`,interp,stepMove,isLast?hold:0));}prev=Object.assign({},target);});return out;}function basePose(kind){const baseKind=(kind==='calibrate'||kind==='init')?'init':'stand';return pulseMapToAbs(presetPulseMap(baseKind));}function defaultCalibratePose(){return basePose('init');}function defaultStandPose(){return basePose('stand');}function defaultHomePose(){return defaultStandPose();}function defaultFrame(name){return {name:name||('frame-'+(state.frames.length+1)),s:defaultStandPose(),v:300,d:0};}\n"
"function absToLogical(abs,key){const j=getJointMeta(key);return j.dir*(Number(abs)-Number(j.center_abs_deg??90));}function logicalToAbs(logical,key){const j=getJointMeta(key);return clamp(Number(j.center_abs_deg??90)+j.dir*Number(logical),Number(j.min_abs_deg??0),Number(j.max_abs_deg??270));}function logicalToView(logical){return Number(logical)*MODEL_VIEW_SIGN;}function viewToLogical(viewLogical){return Number(viewLogical)*MODEL_VIEW_SIGN;}function currentFrame(){if(!state.frames.length){state.frames=[defaultFrame('frame-1')];state.selected=0;}return state.frames[state.selected];}\n"
"function buildSequenceObject(frames){return {a:(frames||state.frames).map((f,idx)=>{const item={n:f.name||('frame-'+(idx+1)),v:clamp(f.v||300,20,5000),d:clamp(f.d||0,0,10000)};if(f.p){item.p={lf:clampPulseForJoint('lf',f.p.lf),rf:clampPulseForJoint('rf',f.p.rf),lr:clampPulseForJoint('lr',f.p.lr),rr:clampPulseForJoint('rr',f.p.rr)};}else{item.s={lf:clamp(f.s.lf,0,270),rf:clamp(f.s.rf,0,270),lr:clamp(f.s.lr,0,270),rr:clamp(f.s.rr,0,270)};}return item;}),d:clamp(qs('topDelay').value||0,0,10000)};}\n"
"function getTemplateMeta(kind){return TEMPLATE_META[kind]||{label:kind,desc:'当前模板会先生成关键帧，再可直接整段发到设备。',steps:true,amp:true,recover:false};}\n"
"function setFieldVisible(id,visible){const el=qs(id);if(!el)return;el.classList.toggle('field-hidden',!visible);}\n"
"function refreshTemplateForm(){const kind=qs('genKind').value;const meta=getTemplateMeta(kind);setFieldVisible('genStepsWrap',!!meta.steps);setFieldVisible('genAmpWrap',meta.amp!==false);setFieldVisible('genRecoverWrap',!!meta.recover);setFieldVisible('genPauseWrap',true);const hint=qs('templateHint');if(hint){hint.textContent=meta.desc+(meta.steps?' 可通过“步数 / 循环”控制重复次数。':' 该模板不需要额外步数设置。');}const runBtn=qs('runTemplateBtn');if(runBtn){runBtn.textContent=`运行${meta.label}`;}}\n"
"function shouldRunViaNative(template){return NATIVE_RUN_TEMPLATES.has(String(template||'').trim().toLowerCase());}\n"
"async function runNamedAction(template,steps,speed){const key=String(template||'').trim().toLowerCase();const payload={action:'dog_pose_preset',params:{name:key}};if(steps!=null&&payload.params){payload.params.steps=steps;}if(speed&&payload.params){payload.params.speed=speed;}try{const res=await fetch('/api/command',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const data=await res.json();setOut(typeof data==='object'&&data?Object.assign({template:key},data):data);await refreshDeviceMeta();}catch(err){setOut('执行动作失败: '+err);}}\n"
"async function quickRun(kind,speed,steps,amp,pause){qs('genKind').value=kind;qs('genSpeed').value=speed||'normal';qs('genSteps').value=steps||1;qs('genAmp').value=amp||18;qs('genPause').value=pause||0;refreshTemplateForm();generateFromControls();if(shouldRunViaNative(kind)){await runNamedAction(kind,steps||1,speed||'normal');return;}await sendSequence('all');}\n"
"function syncJsonText(){qs('jsonText').value=JSON.stringify(buildSequenceObject(),null,2);}function selectFrame(index){state.selected=clamp(index,0,state.frames.length-1);renderAll();}\n"
"function renderFrameTable(){const tb=qs('frameTable');tb.innerHTML='';state.frames.forEach((f,idx)=>{const tr=document.createElement('tr');if(idx===state.selected)tr.className='active';tr.onclick=()=>selectFrame(idx);tr.innerHTML=`<td>${idx+1}</td><td>${f.name||''}</td><td>${f.s.lf}</td><td>${f.s.rf}</td><td>${f.s.lr}</td><td>${f.s.rr}</td><td>${f.v}</td><td>${f.d||0}</td>`;tb.appendChild(tr);});}\n"
"function setSliderPair(key,value){const range=qs(key+'Range');const num=qs(key+'Number');if(range)range.value=value;if(num)num.value=value;}\n"
"function renderInspector(){const f=currentFrame();qs('frameName').value=f.name||'';qs('moveMs').value=f.v||300;qs('pauseMs').value=f.d||0;JOINT_KEYS.forEach(k=>setSliderPair(k,f.s[k]));}\n"
"function updateFrameFromInputs(){const f=currentFrame();f.name=qs('frameName').value||('frame-'+(state.selected+1));f.v=clamp(qs('moveMs').value,20,5000);f.d=clamp(qs('pauseMs').value,0,10000);delete f.p;JOINT_KEYS.forEach(k=>{f.s[k]=clamp(qs(k+'Number').value,0,270);});renderAll();}\n"
"function applySliderMeta(){const tips=[];JOINT_KEYS.forEach(k=>{const meta=getJointMeta(k);const safeMin=meta.min_abs_deg??0;const safeMax=meta.max_abs_deg??270;const hint=`设备建议安全范围 ${safeMin}-${safeMax}°`;const range=qs(k+'Range');const num=qs(k+'Number');range.min=0;range.max=270;num.min=0;num.max=270;range.title=hint;num.title=hint;tips.push(`${k.toUpperCase()} ${safeMin}-${safeMax}°`);});const tip=qs('angleRangeTip');if(tip){tip.textContent=`角度编辑允许 0-270°；当前设备建议安全范围：${tips.join(' / ')}`;}}\n"
"function renderDogModel(){const f=currentFrame();JOINT_KEYS.forEach(k=>{const line=qs(k+'Leg');const handle=qs(k+'Handle');const hip=MODEL_HIPS[k];const footY=MODEL_FEET_Y[k];const logical=absToLogical(f.s[k],k);const footX=hip[0]+logicalToView(logical)*MODEL_X_SCALE;line.setAttribute('x1',hip[0]);line.setAttribute('y1',hip[1]);line.setAttribute('x2',footX);line.setAttribute('y2',footY);handle.setAttribute('cx',footX);handle.setAttribute('cy',footY);handle.classList.toggle('dragging',state.dragKey===k);});qs('modelText').textContent=`当前帧 ${state.selected+1}/${state.frames.length} | 逻辑角: LF ${absToLogical(f.s.lf,'lf')} / RF ${absToLogical(f.s.rf,'rf')} / LR ${absToLogical(f.s.lr,'lr')} / RR ${absToLogical(f.s.rr,'rr')}`;}\n"
"function initThreePreview(){const host=qs('dog3dCanvas');const status=qs('dog3dStatus');if(!host||state.three){return;}if(!(window.THREE&&window.THREE.WebGLRenderer)){host.classList.add('empty');host.textContent='当前浏览器没有加载到 three.js，已回退到下方 2D 编辑器。';if(status)status.textContent='3D 预览未启用：three.js CDN 不可用';return;}const THREE=window.THREE;const scene=new THREE.Scene();scene.background=new THREE.Color(0x020617);const camera=new THREE.PerspectiveCamera(34,Math.max(1,host.clientWidth)/Math.max(1,host.clientHeight),0.1,100);camera.position.set(0.2,2.4,5.8);const renderer=new THREE.WebGLRenderer({antialias:true,alpha:true});renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));renderer.setSize(Math.max(1,host.clientWidth),Math.max(1,host.clientHeight));host.innerHTML='';host.appendChild(renderer.domElement);const controls=THREE.OrbitControls?new THREE.OrbitControls(camera,renderer.domElement):null;if(controls){controls.enableDamping=true;controls.target.set(0.35,0.55,0);controls.update();}camera.lookAt(0.35,0.55,0);scene.add(new THREE.AmbientLight(0xffffff,1.35));const keyLight=new THREE.DirectionalLight(0xffffff,1.8);keyLight.position.set(3.2,5.5,4.2);scene.add(keyLight);const rimLight=new THREE.DirectionalLight(0x60a5fa,0.9);rimLight.position.set(-3.2,2.4,-4.4);scene.add(rimLight);const floor=new THREE.Mesh(new THREE.CircleGeometry(3.4,48),new THREE.MeshStandardMaterial({color:0x0f172a,metalness:0.05,roughness:0.95}));floor.rotation.x=-Math.PI/2;floor.position.y=-0.66;scene.add(floor);const rig=new THREE.Group();rig.position.x=-0.42;scene.add(rig);const bodyPivot=new THREE.Group();rig.add(bodyPivot);const body=new THREE.Mesh(new THREE.BoxGeometry(2.15,0.8,1.1),new THREE.MeshStandardMaterial({color:0x1e293b,metalness:0.18,roughness:0.72}));body.position.y=0.72;bodyPivot.add(body);const head=new THREE.Mesh(new THREE.SphereGeometry(0.34,28,20),new THREE.MeshStandardMaterial({color:0x334155,metalness:0.12,roughness:0.7}));head.position.set(1.28,0.88,0);bodyPivot.add(head);const nose=new THREE.Mesh(new THREE.BoxGeometry(0.22,0.14,0.18),new THREE.MeshStandardMaterial({color:0x475569}));nose.position.set(1.55,0.78,0);bodyPivot.add(nose);const legs={};function makeLeg(key,x,z,color){const hip=new THREE.Group();hip.position.set(x,0.45,z);bodyPivot.add(hip);const upper=new THREE.Mesh(new THREE.CylinderGeometry(0.06,0.075,1.02,18),new THREE.MeshStandardMaterial({color:color,metalness:0.1,roughness:0.55}));upper.position.y=-0.5;hip.add(upper);const foot=new THREE.Mesh(new THREE.SphereGeometry(0.1,18,14),new THREE.MeshStandardMaterial({color:0xe2e8f0,metalness:0.02,roughness:0.9}));foot.position.y=-1.02;hip.add(foot);legs[key]=hip;}makeLeg('lf',0.62,-0.34,0x38bdf8);makeLeg('rf',0.62,0.34,0xf472b6);makeLeg('lr',-0.54,-0.34,0x22c55e);makeLeg('rr',-0.54,0.34,0xf59e0b);state.three={scene,camera,renderer,controls,bodyPivot,rig,legs,host,lastW:0,lastH:0};if(status)status.textContent='3D 预览已启用：可拖动鼠标旋转视角';const tick=()=>{if(!state.three||state.three.host!==host){return;}const w=Math.max(1,host.clientWidth);const h=Math.max(1,host.clientHeight);if(w!==state.three.lastW||h!==state.three.lastH){state.three.lastW=w;state.three.lastH=h;renderer.setSize(w,h,false);camera.aspect=w/h;camera.updateProjectionMatrix();}if(controls){controls.update();}renderer.render(scene,camera);window.requestAnimationFrame(tick);};window.requestAnimationFrame(()=>{if(controls){controls.update();}renderer.render(scene,camera);tick();});}\n"
"function renderThreeDog(){const t=state.three;if(!t){return;}const f=currentFrame();JOINT_KEYS.forEach(k=>{const logical=clamp(absToLogical(f.s[k],k),-50,50);t.legs[k].rotation.z=(logicalToView(logical)*Math.PI/180)*0.95;});const frontBias=(absToLogical(f.s.lf,'lf')+absToLogical(f.s.rf,'rf'))-(absToLogical(f.s.lr,'lr')+absToLogical(f.s.rr,'rr'));const turnBias=(absToLogical(f.s.rf,'rf')+absToLogical(f.s.rr,'rr'))-(absToLogical(f.s.lf,'lf')+absToLogical(f.s.lr,'lr'));t.bodyPivot.rotation.x=clamp(logicalToView(frontBias)*0.008,-0.18,0.18);t.bodyPivot.rotation.y=clamp(logicalToView(turnBias)*0.012,-0.34,0.34);t.rig.position.y=clamp((Math.max(absToLogical(f.s.lf,'lf'),absToLogical(f.s.rf,'rf'))*0.005),-0.06,0.12);}\n"
"function renderMeta(){const ready=Boolean((state.meta&&state.meta.ready)||(state.status&&state.status.ready));qs('readyText').textContent=ready?'true':'false';qs('ipText').textContent=state.meta&&state.meta.ip?state.meta.ip:'<未连接WiFi>';qs('urlText').textContent=state.meta&&state.meta.url?state.meta.url:'<不可用>';qs('formatText').textContent=state.meta&&state.meta.formats?state.meta.formats.join(' / '):'motutu';const text=(state.meta&&state.meta.joints?state.meta.joints:[]).map(j=>`${j.key}: center ${j.center_abs_deg}, abs ${j.min_abs_deg}-${j.max_abs_deg}, logical ${j.min_logical_deg}..${j.max_logical_deg}, dir=${j.dir}`).join(' ｜ ');const sizeTip=state.meta&&state.meta.sequence_body_max?` ｜ 请求上限 ${state.meta.sequence_body_max} bytes`:'';qs('jointMetaText').textContent=(text||'尚未读取到关节校准信息')+sizeTip;}\n"
"function syncExecutionScopes(value){const normalized=value==='current'?'current':'all';['execScope','execScopeTop'].forEach(id=>{const el=qs(id);if(el&&el.value!==normalized)el.value=normalized;});return normalized;}function getExecutionScope(){const top=qs('execScopeTop');const main=qs('execScope');const value=(top&&top.value)||(main&&main.value)||'all';return syncExecutionScopes(value);}function getExecutionFrames(scope){scope=scope||getExecutionScope();if(scope==='current'){return [deepCopy(currentFrame())];}return state.frames.slice();}function getExecutionScopeLabel(scope){return scope==='current'?'当前帧':'全部帧';}\n"
"function renderAll(){if(!state.frames.length){state.frames=[defaultFrame('frame-1')];state.selected=0;}renderFrameTable();renderInspector();renderDogModel();renderThreeDog();renderMeta();syncJsonText();}\n"
"function addFrame(){const f=deepCopy(currentFrame());f.name='frame-'+(state.frames.length+1);state.frames.splice(state.selected+1,0,f);state.selected+=1;renderAll();}\n"
"function cloneFrame(){const f=deepCopy(currentFrame());f.name=(f.name||'frame')+'-copy';state.frames.splice(state.selected+1,0,f);state.selected+=1;renderAll();}\n"
"function deleteFrame(){if(state.frames.length<=1){state.frames=[defaultFrame('frame-1')];state.selected=0;}else{state.frames.splice(state.selected,1);state.selected=Math.max(0,state.selected-1);}renderAll();}\n"
"function moveFrame(dir){const idx=state.selected;const target=idx+dir;if(target<0||target>=state.frames.length)return;const tmp=state.frames[idx];state.frames[idx]=state.frames[target];state.frames[target]=tmp;state.selected=target;renderAll();}\n"
"function downloadText(name,text){const blob=new Blob([text],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},0);}\n"
