"<!doctype html>\n"
"<html lang='zh-CN'>\n"
"<head>\n"
"<meta charset='utf-8'>\n"
"<meta name='viewport' content='width=device-width, initial-scale=1'>\n"
"<title>Motutu Keyframe Studio</title>\n"
"<script src='https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js'></script>\n"
"<script src='https://cdn.jsdelivr.net/npm/three@0.160.0/examples/js/controls/OrbitControls.js'></script>\n"
"<style>\n"
":root{color-scheme:dark;--bg:#0f172a;--card:#111827;--card2:#0b1220;--line:#334155;--text:#e2e8f0;--muted:#94a3b8;--accent:#2563eb;--accent2:#0ea5e9;--ok:#16a34a;--warn:#f59e0b;}\n"
"*{box-sizing:border-box;}body{margin:0;background:linear-gradient(180deg,#0f172a,#020617);color:var(--text);font-family:Arial,sans-serif;}main{max-width:1440px;margin:0 auto;padding:16px;}h1,h2,h3{margin:0 0 12px;}small,.muted{color:var(--muted);}button,select,input,textarea{font:inherit;}button{border:0;border-radius:10px;padding:10px 14px;background:var(--accent);color:#fff;cursor:pointer;}button.secondary{background:#475569;}button.ghost{background:transparent;border:1px solid var(--line);}button.warn{background:#b45309;}input,select,textarea{width:100%;background:#020617;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:10px;}textarea{min-height:180px;font-family:Consolas,monospace;}label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px;}pre{margin:0;background:#020617;border:1px solid var(--line);border-radius:12px;padding:12px;white-space:pre-wrap;word-break:break-word;}table{width:100%;border-collapse:collapse;font-size:13px;}th,td{padding:8px;border-bottom:1px solid #1e293b;text-align:left;}tr.active{background:#172554;}tr:hover{background:#0f1b33;}svg{width:100%;height:auto;background:#020617;border:1px solid var(--line);border-radius:12px;} .preview3d{width:100%;height:320px;background:#020617;border:1px solid var(--line);border-radius:12px;overflow:hidden;position:relative;} .preview3d canvas{display:block;width:100%;height:100%;} .preview3d.empty{display:flex;align-items:center;justify-content:center;padding:16px;text-align:center;color:var(--muted);}\n"
".hero{display:flex;justify-content:space-between;gap:16px;align-items:flex-start;flex-wrap:wrap;margin-bottom:16px;}.hero .title{flex:1 1 420px;}.hero .actions{display:flex;gap:8px;flex-wrap:wrap;}.grid{display:grid;grid-template-columns:1.08fr .92fr;gap:16px;align-items:start;}.col{display:grid;gap:16px;}.card{background:rgba(17,24,39,.96);border:1px solid rgba(51,65,85,.9);border-radius:16px;padding:16px;box-shadow:0 12px 30px rgba(0,0,0,.18);} .row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;} .row2{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;} .toolbar{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;} .stack{display:grid;gap:10px;} .status{display:flex;gap:16px;flex-wrap:wrap;font-size:14px;} .pill{display:inline-block;padding:4px 10px;border-radius:999px;background:#0b1220;border:1px solid var(--line);} .ok{color:#86efac;} .warn-txt{color:#fcd34d;} .frame-list{max-height:360px;overflow:auto;border:1px solid var(--line);border-radius:12px;} .mini{font-size:12px;} .split{display:grid;grid-template-columns:1fr 1fr;gap:12px;} .range-row{display:grid;grid-template-columns:70px 1fr 72px;gap:8px;align-items:center;} .json-tools{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;} .drag-tip{margin-top:8px;} .drag-handle{cursor:grab;touch-action:none;} .drag-handle.dragging{cursor:grabbing;} .drag-line{cursor:ew-resize;} .guide{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;} .guide-item{padding:12px;border:1px solid var(--line);border-radius:12px;background:rgba(2,6,23,.55);} .guide-item strong{display:block;margin-bottom:4px;} .quick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;} .quick-btn{width:100%;text-align:left;padding:12px 14px;border-radius:12px;background:#13213d;border:1px solid #28406f;} .quick-btn strong{display:block;margin-bottom:3px;font-size:14px;} .quick-btn span{display:block;font-size:12px;color:var(--muted);} .section-note{margin-top:10px;font-size:12px;color:var(--muted);} .compact{margin-bottom:0;} .template-side-note{margin-top:10px;padding:10px 12px;border-radius:12px;background:#0b1220;border:1px solid var(--line);font-size:12px;color:var(--muted);} details.card summary{cursor:pointer;list-style:none;font-weight:700;} details.card summary::-webkit-details-marker{display:none;} details.card[open] summary{margin-bottom:12px;} .field-hidden{display:none;} @media (max-width:1100px){.grid{grid-template-columns:1fr;}.row,.row2,.split,.guide,.quick-grid{grid-template-columns:1fr;}}\n"
"</style>\n"
"</head>\n"
"<body>\n"
"<main>\n"
"  <section class='hero'>\n"
"    <div class='title'>\n"
"      <h1>Motutu 关键帧编排器</h1>\n"
"      <div class='muted'>设备内置 H5 页面，支持关键帧编辑、机械狗模型预览、文本/模板生成，以及 Rerobot 适配导入导出。</div>\n"
"    </div>\n"
"    <div class='actions'>\n"
"      <button onclick='refreshDeviceMeta()'>刷新设备信息</button>\n"
"      <button class='secondary' onclick='loadCurrentPoseFrame()'>导入当前姿态</button>\n"
"      <button class='secondary' onclick='showControlPageHint()'>屏幕显示地址</button>\n"
"    </div>\n"
"  </section>\n"
"  <section class='card'>\n"
"    <div class='guide'>\n"
"      <div class='guide-item'><strong>1. 先跑常用动作</strong><span class='mini muted'>站立、校正、前进、转向都在一键动作里，先确认机械状态。</span></div>\n"
"      <div class='guide-item'><strong>2. 再调模板参数</strong><span class='mini muted'>要改步数、摆幅、速度时，用模板运行区；选完参数可直接运行。</span></div>\n"
"      <div class='guide-item'><strong>3. 最后再做高级编辑</strong><span class='mini muted'>关键帧和 JSON 留给需要精调或接云端编排时再用。</span></div>\n"
"    </div>\n"
"  </section>\n"
"  <div class='grid'>\n"
"    <div class='col'>\n"
"      <section class='card'>\n"
"        <h2>设备状态</h2>\n"
"        <div class='status'>\n"
"          <span class='pill'>Ready: <strong id='readyText'>-</strong></span>\n"
"          <span class='pill'>IP: <strong id='ipText'>-</strong></span>\n"
"          <span class='pill'>URL: <strong id='urlText'>-</strong></span>\n"
"          <span class='pill'>格式: <strong id='formatText'>motutu / rerobot</strong></span>\n"
"        </div>\n"
"        <div class='mini muted' id='jointMetaText' style='margin-top:10px;'></div>\n"
"      </section>\n"
"      <section class='card'>\n"
"        <h2>常用动作</h2>\n"
"        <div class='quick-grid'>\n"
"          <button class='quick-btn' onclick=\"quickRun('stand','normal',1,18,0)\"><strong>站立复位</strong><span>直接回默认站立姿态</span></button>\n"
"          <button class='quick-btn' onclick=\"quickRun('init','normal',1,18,0)\"><strong>校正位置</strong><span>回装配伸直位，便于对位</span></button>\n"
"          <button class='quick-btn' onclick=\"quickRun('down','normal',1,18,0)\"><strong>趴下</strong><span>快速测试低姿态动作</span></button>\n"
"          <button class='quick-btn' onclick=\"quickRun('walk','normal',5,18,0)\"><strong>前进 5 步</strong><span>完整检查前进行走和回站立</span></button>\n"
"          <button class='quick-btn' onclick=\"quickRun('back','normal',5,18,0)\"><strong>后退 5 步</strong><span>完整检查后退步态和回站立</span></button>\n"
"          <button class='quick-btn' onclick=\"quickRun('left','normal',2,18,80)\"><strong>左转</strong><span>延长转向节奏，观察落脚后回站立</span></button>\n"
"          <button class='quick-btn' onclick=\"quickRun('right','normal',2,18,80)\"><strong>右转</strong><span>延长转向节奏，观察落脚后回站立</span></button>\n"
"          <button class='quick-btn' onclick=\"quickRun('wave_left','normal',1,18,0)\"><strong>左招手</strong><span>测试左前腿抬起动作</span></button>\n"
"          <button class='quick-btn' onclick=\"quickRun('wave_right','normal',1,18,0)\"><strong>右招手</strong><span>测试右前腿抬起动作</span></button>\n"
"        </div>\n"
"        <div class='section-note'>这里是现场联调最常用的入口；只有需要更细的速度、步数和摆幅控制时，再用下面的模板运行。</div>\n"
"      </section>\n"
"      <section class='card'>\n"
"        <h2>模板运行</h2>\n"
"        <div class='row2'>\n"
"          <div><label>模板</label><select id='genKind'><option value='stand'>站立复位</option><option value='init'>校正位置</option><option value='down'>趴下</option><option value='nod'>点头</option><option value='swing'>左右摆</option><option value='flip'>翻跟斗</option><option value='wave_left'>左招手</option><option value='wave_right'>右招手</option><option value='shake_left'>左握手</option><option value='shake_right'>右握手</option><option value='spin_left'>原地左旋</option><option value='spin_right'>原地右旋</option><option value='serve_left'>左前发球</option><option value='serve_right'>右前发球</option><option value='walk'>前进</option><option value='back'>后退</option><option value='left'>左转</option><option value='right'>右转</option></select></div>\n"
"          <div><label>速度</label><select id='genSpeed'><option value='slow'>slow</option><option value='normal' selected>normal</option><option value='fast'>fast</option></select></div>\n"
"        </div>\n"
"        <div class='row' style='margin-top:10px;'>\n"
"          <div id='genStepsWrap'><label>步数 / 循环</label><input id='genSteps' type='number' min='1' max='32' value='5'></div>\n"
"          <div id='genAmpWrap'><label>摆幅(逻辑角度)</label><input id='genAmp' type='number' min='6' max='36' value='18'></div>\n"
"          <div id='genRecoverWrap'><label>回摆角</label><input id='genRecover' type='number' min='2' max='16' value='6'></div>\n"
"          <div id='genPauseWrap'><label>额外停顿(ms)</label><input id='genPause' type='number' min='0' max='1000' step='20' value='0'></div>\n"
"        </div>\n"
"        <div class='template-side-note' id='templateHint'>当前模板会先生成关键帧，再可直接整段发到设备。</div>\n"
"        <div style='margin-top:10px;'><label>文本描述（可选）</label><textarea id='promptText' style='min-height:92px;' placeholder='例如: 生成一个前进3步、慢速、小摆幅的动作草稿；或：点头两次后回站立'></textarea></div>\n"
"        <div class='toolbar' style='margin-top:12px;'>\n"
"          <button class='primary' id='runTemplateBtn' onclick='runTemplateNow()'>运行模板</button>\n"
"          <button onclick='generateFromControls()'>只生成关键帧</button>\n"
"          <button class='secondary' onclick='runPromptNow()'>按文本运行</button>\n"
"          <button class='ghost' onclick='generateFromPrompt()'>按文本生成</button>\n"
"          <button class='ghost' onclick='appendGenerated()'>追加到现有序列</button>\n"
"        </div>\n"
"      </section>\n"
"      <section class='card'>\n"
"        <h2>运行与结果</h2>\n"
"        <div class='toolbar'>\n"
"          <button onclick='sendSequence()'>发送到设备</button>\n"
"          <button class='ghost' onclick='playPreview()'>预览</button>\n"
"          <button class='ghost' onclick='stopPreview()'>停止预览</button>\n"
"          <button class='secondary' onclick='queryStatus()'>查询状态</button>\n"
"        </div>\n"
"        <div class='row2' style='margin:12px 0 10px;'>\n"
"          <div><label>执行范围</label><select id='execScopeTop' onchange='syncExecutionScopes(this.value)'><option value='current'>当前帧</option><option value='all' selected>全部帧</option></select></div>\n"
"          <div class='mini muted' style='align-self:end;'>调单个姿态时选“当前帧”，整段联调时选“全部帧”。</div>\n"
"        </div>\n"
"        <pre id='outTop'>页面已加载，等待操作。</pre>\n"
"      </section>\n"
"    </div>\n"
"    <div class='col'>\n"
"      <section class='card'>\n"
"        <h2>机械狗模型预览</h2>\n"
"        <div id='dog3dCanvas' class='preview3d'></div>\n"
"        <div class='mini muted' id='dog3dStatus' style='margin-top:8px;'>3D 预览初始化中...</div>\n"
"        <div class='mini muted' style='margin-top:8px;'>先看上方 3D 大姿态，再用下面 2D 拖拽修正单腿，会比直接盯数字更容易。</div>\n"
"        <div style='height:10px;'></div>\n"
"        <svg id='dogSvg' viewBox='0 0 420 260' aria-label='motutu-model'>\n"
"          <rect x='130' y='82' width='160' height='92' rx='20' fill='#1e293b' stroke='#64748b' stroke-width='2'></rect>\n"
"          <circle cx='305' cy='110' r='22' fill='#1e293b' stroke='#64748b' stroke-width='2'></circle>\n"
"          <line id='lfLeg' class='drag-line' data-joint='lf' x1='255' y1='106' x2='240' y2='140' stroke='#38bdf8' stroke-width='8' stroke-linecap='round'></line>\n"
"          <line id='lrLeg' class='drag-line' data-joint='lr' x1='165' y1='106' x2='150' y2='140' stroke='#22c55e' stroke-width='8' stroke-linecap='round'></line>\n"
"          <line id='rfLeg' class='drag-line' data-joint='rf' x1='255' y1='166' x2='270' y2='206' stroke='#f472b6' stroke-width='8' stroke-linecap='round'></line>\n"
"          <line id='rrLeg' class='drag-line' data-joint='rr' x1='165' y1='166' x2='180' y2='206' stroke='#f59e0b' stroke-width='8' stroke-linecap='round'></line>\n"
"          <circle id='lfHandle' class='drag-handle' data-joint='lf' cx='240' cy='140' r='10' fill='#38bdf8' stroke='#e0f2fe' stroke-width='2'></circle>\n"
"          <circle id='lrHandle' class='drag-handle' data-joint='lr' cx='150' cy='140' r='10' fill='#22c55e' stroke='#dcfce7' stroke-width='2'></circle>\n"
"          <circle id='rfHandle' class='drag-handle' data-joint='rf' cx='270' cy='206' r='10' fill='#f472b6' stroke='#fce7f3' stroke-width='2'></circle>\n"
"          <circle id='rrHandle' class='drag-handle' data-joint='rr' cx='180' cy='206' r='10' fill='#f59e0b' stroke='#fef3c7' stroke-width='2'></circle>\n"
"          <text x='242' y='132' fill='#38bdf8' font-size='14'>LF</text>\n"
"          <text x='152' y='132' fill='#22c55e' font-size='14'>LR</text>\n"
"          <text x='272' y='224' fill='#f472b6' font-size='14'>RF</text>\n"
"          <text x='182' y='224' fill='#f59e0b' font-size='14'>RR</text>\n"
"        </svg>\n"
"        <div class='mini muted drag-tip'>可直接拖动四个圆点，生成当前帧姿态。</div>\n"
"        <div class='mini muted' id='modelText' style='margin-top:10px;'></div>\n"
"      </section>\n"
"      <section class='card'>\n"
"        <h2>当前帧编辑</h2>\n"
"        <div class='row2'>\n"
"          <div><label>帧名称</label><input id='frameName' placeholder='例如: step-1'></div>\n"
"          <div><label>顶层结束停顿(ms)</label><input id='topDelay' type='number' min='0' max='10000' step='20' value='0'></div>\n"
"        </div>\n"
"        <div class='stack' style='margin-top:12px;'>\n"
"          <div class='range-row'><strong>LF</strong><input id='lfRange' type='range' min='0' max='270' value='90'><input id='lfNumber' type='number' min='0' max='270' value='90'></div>\n"
"          <div class='range-row'><strong>RF</strong><input id='rfRange' type='range' min='0' max='270' value='90'><input id='rfNumber' type='number' min='0' max='270' value='90'></div>\n"
"          <div class='range-row'><strong>LR</strong><input id='lrRange' type='range' min='0' max='270' value='110'><input id='lrNumber' type='number' min='0' max='270' value='110'></div>\n"
"          <div class='range-row'><strong>RR</strong><input id='rrRange' type='range' min='0' max='270' value='110'><input id='rrNumber' type='number' min='0' max='270' value='110'></div>\n"
"        </div>\n"
"        <div class='row2' style='margin-top:12px;'>\n"
"          <div><label>过渡时长 v (ms)</label><input id='moveMs' type='number' min='20' max='5000' step='20' value='300'></div>\n"
"          <div><label>停顿 d (ms)</label><input id='pauseMs' type='number' min='0' max='10000' step='20' value='0'></div>\n"
"        </div>\n"
"        <div class='mini muted' id='angleRangeTip' style='margin-top:8px;'>角度编辑允许 0-270°；设备建议安全范围读取中...</div>\n"
"      </section>\n"
"      <section class='card'>\n"
"        <h2>关键帧列表</h2>\n"
"        <div class='toolbar'>\n"
"          <button onclick='addFrame()'>新增帧</button>\n"
"          <button class='secondary' onclick='cloneFrame()'>复制当前帧</button>\n"
"          <button class='secondary' onclick='moveFrame(-1)'>上移</button>\n"
"          <button class='secondary' onclick='moveFrame(1)'>下移</button>\n"
"          <button class='warn' onclick='deleteFrame()'>删除当前帧</button>\n"
"        </div>\n"
"        <div class='frame-list'>\n"
"          <table>\n"
"            <thead><tr><th>#</th><th>名称</th><th>LF</th><th>RF</th><th>LR</th><th>RR</th><th>过渡</th><th>停顿</th></tr></thead>\n"
"            <tbody id='frameTable'></tbody>\n"
"          </table>\n"
"        </div>\n"
"        <div class='section-note'>只有需要精调单帧、重排顺序时再使用这里；大部分现场调试用左侧的常用动作和模板运行就够了。</div>\n"
"      </section>\n"
"      <details class='card'>\n"
"        <summary>高级：JSON / Rerobot 对接</summary>\n"
"        <div class='json-tools'>\n"
"          <button onclick='syncJsonText()'>同步 JSON</button>\n"
"          <button class='secondary' onclick='exportMotutuJson()'>导出 Motutu JSON</button>\n"
"          <button class='secondary' onclick='exportRerobotJson()'>导出 Rerobot 适配 JSON</button>\n"
"          <button class='ghost' onclick='applyJsonEditor()'>应用文本到关键帧</button>\n"
"          <button class='ghost' onclick='document.getElementById(\"importFile\").click()'>导入文件</button>\n"
"          <button class='ghost' onclick='clearToHome()'>清空为站立</button>\n"
"          <input id='importFile' type='file' accept='.json,application/json' style='display:none'>\n"
"        </div>\n"
"        <textarea id='jsonText'></textarea>\n"
"        <div class='mini muted' style='margin-top:8px;'>可直接改这里的 JSON；改完点“应用文本到关键帧”，或按 `Ctrl+Enter`，关键帧列表会立刻同步。设备支持角度帧 `s:{lf,rf,lr,rr}`，也支持直接下发脉宽帧 `p:{lf,rf,lr,rr}`。</div>\n"
"      </details>\n"
"    </div>\n"
"  </div>\n"
"</main>\n"
"<script>\n"
"const JOINT_KEYS=['lf','rf','lr','rr'];\n"
"const MODEL_HIPS={lf:[255,106],lr:[165,106],rf:[255,166],rr:[165,166]};\n"
"const MODEL_FEET_Y={lf:140,lr:140,rf:206,rr:206};\n"
"const MODEL_X_SCALE=1.3;\n"
"const MODEL_VIEW_SIGN=-1;\n"
"const TEMPLATE_META={stand:{label:'站立复位',desc:'直接回默认站立姿态，适合作为动作结束回位。',steps:false,amp:false,recover:false},init:{label:'校正位置',desc:'回装配伸直位，便于结构对位。',steps:false,amp:false,recover:false},down:{label:'趴下',desc:'快速测试低姿态动作。',steps:false,amp:true,recover:false},nod:{label:'点头',desc:'用于验证前腿小幅往复动作。',steps:false,amp:false,recover:false},swing:{label:'左右摆',desc:'左右摆动身体，适合看整体协调。',steps:false,amp:true,recover:false},flip:{label:'翻跟斗',desc:'完整的大动作模板，建议先单独预览。',steps:false,amp:false,recover:false},wave_left:{label:'左招手',desc:'左前腿抬起并挥动。',steps:false,amp:false,recover:false},wave_right:{label:'右招手',desc:'右前腿抬起并挥动。',steps:false,amp:false,recover:false},shake_left:{label:'左握手',desc:'左前腿抬起做握手动作。',steps:false,amp:false,recover:false},shake_right:{label:'右握手',desc:'右前腿抬起做握手动作。',steps:false,amp:false,recover:false},spin_left:{label:'原地左旋',desc:'原地连续左转，循环数越大转得越多。',steps:true,amp:true,recover:true},spin_right:{label:'原地右旋',desc:'原地连续右转，循环数越大转得越多。',steps:true,amp:true,recover:true},serve_left:{label:'左前发球',desc:'左前腿前送动作。',steps:false,amp:false,recover:false},serve_right:{label:'右前发球',desc:'右前腿前送动作。',steps:false,amp:false,recover:false},walk:{label:'前进',desc:'最常用步态，建议从 1 步开始调。',steps:true,amp:true,recover:true},back:{label:'后退',desc:'反向步态，适合检查后腿配合。',steps:true,amp:true,recover:true},left:{label:'左转',desc:'左右腿摆幅不同的转向模板。',steps:true,amp:true,recover:true},right:{label:'右转',desc:'左右腿摆幅不同的转向模板。',steps:true,amp:true,recover:true}};\n"
