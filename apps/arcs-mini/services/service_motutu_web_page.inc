"function normalizeFrames(obj){if(obj&&Array.isArray(obj.a)){return obj.a.map((item,idx)=>{const pulse=item.p?normalizePulse(item.p):null;return {name:item.n||('frame-'+(idx+1)),s:pulse?pulseMapToAbs(pulse):normalizePose(item.s),p:pulse||undefined,v:clamp(item.v??item.duration_ms??300,20,5000),d:clamp(item.d??item.pause_ms??0,0,10000)};});}if(obj&&Array.isArray(obj.frames)){return obj.frames.map((item,idx)=>{const pulse=item.p?normalizePulse(item.p):null;return {name:item.name||('frame-'+(idx+1)),s:pulse?pulseMapToAbs(pulse):normalizePose(item.pose||item.s||item.joints||item.angles||item.servos),p:pulse||undefined,v:clamp(item.duration_ms??item.duration??item.v??300,20,5000),d:clamp(item.pause_ms??item.pause??item.d??0,0,10000)};});}throw new Error('不支持的 JSON 结构，期望 motutu a[] 或 rerobot frames[]');}\n"
