"function speedPhaseMs(speed){return speed==='slow'?120:(speed==='fast'?62:88);}function speedTurnMs(speed){return speed==='slow'?420:(speed==='fast'?220:320);}function speedAmplitude(speed){return speed==='slow'?12:(speed==='fast'?24:18);}function forwardWave(sample,phaseOffset,push,recover){const max=12;let phase=(sample+phaseOffset)%max;const recoverSamples=3;const stanceSamples=max-recoverSamples;if(phase<recoverSamples){return Math.round(push-((push+recover)*phase)/(recoverSamples-1));}phase-=recoverSamples;return Math.round(-recover+((push+recover)*phase)/(stanceSamples-1));}\n"
